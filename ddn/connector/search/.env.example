# Connector env — register these with: ddn connector env add search --env KEY=value
# The bridge resolves its backend + embedder from these, so the same
# search_documents Command runs on any store without code changes.

# ---- Backend / embedder selection ----
# Stateless containers do NOT persist a local LanceDB file, so production should
# set this to `turbopuffer` and point it at a pre-seeded namespace (see README).
RETRIEVAL_BRIDGE_BACKEND=turbopuffer     # lancedb | turbopuffer | pgvector
RETRIEVAL_BRIDGE_EMBEDDER=local          # local | openai | voyage | cohere

# ---- turbopuffer (required when RETRIEVAL_BRIDGE_BACKEND=turbopuffer) ----
# Key + region from https://turbopuffer.com/dashboard. Region is part of the host
# (https://{region}.turbopuffer.com) and MUST match the key.
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
TURBOPUFFER_NAMESPACE=retrieval-bridge-tickets
