# ─────────────────────────────────────────────────────────────────────────────
# Accounts — the Postgres structured-facts Model (the join target)
# ─────────────────────────────────────────────────────────────────────────────
#
# ⚠️ NORMALLY GENERATED by `ddn model add`.
#   In a real workflow you connect a Postgres data connector to the `accounts`
#   table (DDL in accounts.sql), then run:
#
#       ddn model add <pg-connector-link> accounts
#
#   which introspects the table and emits THREE blocks: the ObjectType
#   (Accounts), this Model, and its ModelPermissions — plus aggregate/filter
#   boilerplate. This file is committed as a representative, hand-trimmed version
#   so the SearchHit → Accounts relationship reads end-to-end. On a live project,
#   let `ddn model add` (re)generate it from the table.
#
# ROLE IN THE PITCH
#   This Model is the structured-facts side of the demo's "join account facts by
#   id" step. A retrieved SearchHit's `id` joins to a row here by `ticket_id`
#   (see relationship_searchhit_account.hml), giving the planner project /
#   plan_tier / monthly_revenue to rank and prioritise hits by customer value —
#   with NO join code. In the local demo, retrieval_bridge/structured.py
#   (SQLite) plays this exact role; the column set below matches it 1:1.
# ─────────────────────────────────────────────────────────────────────────────

kind: ObjectType
version: v1
definition:
  name: Accounts
  description: |
    Per-ticket structured account facts (the Postgres `accounts` table): which
    project a ticket belongs to, the account's plan tier, monthly revenue,
    region, and seat count. Joined to a SearchHit by ticket_id.
  fields:
    - name: ticket_id
      type: String!
      description: Primary key — the ticket id. Join target for SearchHit.id.
    - name: project_id
      type: String!
      description: Stable project identifier (e.g. "proj-atlas").
    - name: project_name
      type: String!
      description: Human-readable project / customer name (e.g. "Atlas Analytics").
    - name: plan_tier
      type: String!
      description: Subscription tier (free | launch | scale | enterprise). Used to rank hits.
    - name: monthly_revenue
      type: Float!
      description: Account MRR in USD. Used to prioritise high-value customers.
    - name: account_region
      type: String!
      description: Hosting/region for the account (e.g. "us-east-1").
    - name: seat_count
      type: Int!
      description: Number of seats on the account.
  graphql:
    typeName: Accounts
    inputTypeName: AccountsInput
  dataConnectorTypeMapping:
    - dataConnectorName: pg
      dataConnectorObjectType: accounts

---
kind: TypePermissions
version: v1
definition:
  typeName: Accounts
  permissions:
    - role: admin
      output:
        allowedFields:
          - ticket_id
          - project_id
          - project_name
          - plan_tier
          - monthly_revenue
          - account_region
          - seat_count

---
kind: Model
version: v1
definition:
  name: Accounts
  description: Structured account facts keyed by ticket_id; the join target for retrieved SearchHits.
  objectType: Accounts
  # ── The Postgres data source backing this Model. `dataConnectorName` is the
  #    Postgres DataConnectorLink; `collection` is the table name. ──
  source:
    dataConnectorName: pg
    collection: accounts
  filterExpressionType: AccountsBoolExp
  orderableFields:
    - fieldName: ticket_id
      orderByDirections:
        enableAll: true
    - fieldName: project_id
      orderByDirections:
        enableAll: true
    - fieldName: project_name
      orderByDirections:
        enableAll: true
    - fieldName: plan_tier
      orderByDirections:
        enableAll: true
    - fieldName: monthly_revenue
      orderByDirections:
        enableAll: true
    - fieldName: account_region
      orderByDirections:
        enableAll: true
    - fieldName: seat_count
      orderByDirections:
        enableAll: true
  graphql:
    selectMany:
      queryRootField: accounts
    selectUniques:
      - queryRootField: accountsByTicketId
        uniqueIdentifier:
          - ticket_id
    filterInputTypeName: AccountsFilterInput
    aggregate:
      queryRootField: accountsAggregate

---
kind: ModelPermissions
version: v1
definition:
  modelName: Accounts
  permissions:
    - role: admin
      select:
        filter: null
