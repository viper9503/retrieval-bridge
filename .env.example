# Copy to .env and fill in only what you need. The default demo needs NOTHING here.

# ---- Backend / embedder selection (defaults shown) ----
RETRIEVAL_BRIDGE_BACKEND=lancedb        # lancedb | turbopuffer | pgvector
RETRIEVAL_BRIDGE_EMBEDDER=local         # local | openai | voyage | cohere

# ---- turbopuffer (only if RETRIEVAL_BRIDGE_BACKEND=turbopuffer) ----
# No free tier: lowest plan is $64/mo minimum (30-day refund window).
# Key + region come from https://turbopuffer.com/dashboard
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1      # MUST match your key's region

# ---- pgvector (only if RETRIEVAL_BRIDGE_BACKEND=pgvector) ----
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/retrieval_bridge

# ---- Cloud embedders (only if you change RETRIEVAL_BRIDGE_EMBEDDER) ----
OPENAI_API_KEY=
VOYAGE_API_KEY=
CO_API_KEY=

# ---- Optional: real LLM for the demo's classify/summarize (otherwise stand-ins) ----
ANTHROPIC_API_KEY=
